{
  "name": "abhijnana",
  "version": "2.0.0",
  "private": true,
  "description": "ABHIJÑĀNA — Registry & Verification System for Flagged Synthetic Media",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n engine,server,web -c green,blue,magenta \"npm:dev:engine\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:full": "npm run dev",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "dev:engine": "engine\\venv\\Scripts\\uvicorn.exe app:app --host 0.0.0.0 --port 4318 --reload --app-dir engine",
    "build": "npm run build --workspace web",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
